APP_KEY=
DB_PASSWORD=
JWT_SECRET=
# Asaas (sandbox). Aspas simples: a chave começa com "$"
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# Conta de administrador criada pelo AdminSeeder (preencha só no .env)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOME=
ADMIN_NICKNAME=

# E-mail da recuperação de senha (RF03). Com MAIL_MAILER=log o código só aparece em storage/logs
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=GameDuo

# Regras de negócio e atendimento
SAQUE_MINIMO=20
EMAIL_SAC=
